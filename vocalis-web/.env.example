# true = serve everything from built-in sample data (demos / UI work, no backend needed)
VITE_USE_MOCKS=false
# Base URL of the product API. The dev server proxies /api to VITE_PROXY_TARGET.
VITE_API_URL=/api/v1/product
VITE_PROXY_TARGET=http://localhost:8000
# Address of the classic UI. Shows a "Switch to classic UI" item in the account menu.
VITE_CLASSIC_URL=
