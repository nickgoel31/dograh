---
// Page title with a small "who is this for" badge and reading time.
const { entry } = Astro.locals.starlightRoute;
const d = entry.data as { title: string; audience?: string; readingTime?: string };
const labels: Record<string, string> = { everyone: 'Everyone', owner: 'Business owner', admin: 'Team admin', developer: 'Developer', operator: 'Operator' };
const aud = d.audience && d.audience !== 'everyone' ? labels[d.audience] : null;
---
<h1 id="_top">{d.title}</h1>
{(aud || d.readingTime) && (
  <p class="meta">
    {aud && <span class={`badge badge-${d.audience}`}>{aud}</span>}
    {d.readingTime && <span class="rt">{d.readingTime} read</span>}
  </p>
)}
<style>
  h1 { margin-top: 1rem; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 700; color: var(--sl-color-white); }
  .meta { display: flex; gap: .6rem; align-items: center; margin-top: .6rem; font-size: var(--sl-text-sm); }
  .badge { padding: .1rem .6rem; border-radius: 999px; border: 1px solid var(--sl-color-accent); color: var(--sl-color-accent-high); background: var(--sl-color-accent-low); font-weight: 600; }
  .rt { color: var(--sl-color-gray-3); }
</style>
