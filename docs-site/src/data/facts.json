{
 "templates": [
  {
   "key": "receptionist",
   "name": "Front Desk",
   "role": "answer calls, answer common questions and take messages",
   "tone": "Friendly",
   "blurb": "Greets callers and answers questions."
  },
  {
   "key": "appointments",
   "name": "Bookings",
   "role": "book, move and cancel appointments",
   "tone": "Professional",
   "blurb": "Books appointments for you."
  },
  {
   "key": "leads",
   "name": "Sales Qualifier",
   "role": "qualify new leads by asking about need, budget and timing",
   "tone": "Playful",
   "blurb": "Finds out which leads are serious."
  },
  {
   "key": "support",
   "name": "Support Hero",
   "role": "help customers solve problems and escalate to a person when needed",
   "tone": "Friendly",
   "blurb": "Solves common problems."
  },
  {
   "key": "orders",
   "name": "Order Taker",
   "role": "take orders accurately and confirm the total",
   "tone": "Playful",
   "blurb": "Takes orders by phone."
  },
  {
   "key": "survey",
   "name": "Survey Bot",
   "role": "run a short customer survey, one question at a time",
   "tone": "Professional",
   "blurb": "Collects feedback."
  },
  {
   "key": "reminders",
   "name": "Payment Reminder",
   "role": "politely remind customers about pending payments and offer ways to pay",
   "tone": "Professional",
   "blurb": "Gently chases payments."
  },
  {
   "key": "salon",
   "name": "Salon Concierge",
   "role": "book salon and spa appointments, explain services and prices, and reschedule politely",
   "tone": "Friendly",
   "blurb": "Books services and answers price questions."
  },
  {
   "key": "realestate",
   "name": "Property Assistant",
   "role": "answer property enquiries, ask about budget, location and timing, and book site visits",
   "tone": "Professional",
   "blurb": "Qualifies buyers and books visits."
  },
  {
   "key": "restaurant",
   "name": "Restaurant Host",
   "role": "take table reservations, answer questions about the menu and opening hours, and note special requests",
   "tone": "Friendly",
   "blurb": "Takes reservations and answers menu questions."
  },
  {
   "key": "coaching",
   "name": "Admissions Counsellor",
   "role": "answer course questions, explain fees and batches, and book a counselling call",
   "tone": "Friendly",
   "blurb": "Handles course enquiries and bookings."
  },
  {
   "key": "hotel",
   "name": "Hotel Reservations",
   "role": "answer room and rate questions, check what guests need, and take booking enquiries",
   "tone": "Professional",
   "blurb": "Answers guest and booking calls."
  },
  {
   "key": "clinic",
   "name": "Clinic Assistant",
   "role": "help patients with appointments and clinic information, never giving medical advice",
   "tone": "Friendly",
   "blurb": "Handles patient calls."
  }
 ],
