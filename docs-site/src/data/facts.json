 "connectors": [
  {
   "id": "google_calendar",
   "name": "Google Calendar",
   "blurb": "Check free times and book appointments straight into your calendar.",
   "fields": [
    {
     "key": "calendar_id",
     "label": "Calendar ID",
     "secret": false,
     "hint": "Google Calendar \u2192 Settings \u2192 your calendar \u2192 Integrate \u2192 Calendar ID. Share the calendar with our address below first.",
     "default": "",
     "optional": false
    },
    {
     "key": "timezone",
     "label": "Time zone",
     "secret": false,
     "hint": "",
     "default": "Asia/Kolkata",
     "optional": true
    },
    {
     "key": "start_hour",
     "label": "Opening hour (0-23)",
     "secret": false,
     "hint": "",
     "default": "9",
     "optional": true
    },
    {
     "key": "end_hour",
     "label": "Closing hour (0-23)",
     "secret": false,
     "hint": "",
     "default": "18",
     "optional": true
    },
    {
     "key": "slot_minutes",
     "label": "Appointment length (minutes)",
     "secret": false,
     "hint": "",
     "default": "30",
     "optional": true
    }
   ],
   "actions": [
    {
     "name": "Check free appointment times",
     "key": "slots",
     "description": "Check which appointment times are free on a given day. Use before offering times to the caller.",
     "params": [
      {
       "name": "date",
       "type": "string",
       "description": "The day to check, as YYYY-MM-DD",
       "required": true
      }
     ]
    },
    {
     "name": "Book an appointment",
     "key": "book",
     "description": "Book an appointment once the caller has agreed a time. Only use a time that was offered as free.",
     "params": [
      {
       "name": "start",
       "type": "string",
       "description": "The agreed time, as YYYY-MM-DD HH:MM (24 hour, local time)",
       "required": true
      },
      {
       "name": "name",
       "type": "string",
       "description": "The caller's name",
       "required": true
      },
      {
       "name": "phone",
       "type": "string",
       "description": "The caller's phone number",
       "required": false
      },
      {
       "name": "email",
       "type": "string",
       "description": "The caller's email",
       "required": false
      }
     ]
    }
   ],
   "pushes": false
  },
  {
   "id": "calendly",
   "name": "Calendly",
   "blurb": "Check free times and book into your Calendly event.",
   "fields": [
    {
     "key": "token",
     "label": "Personal access token",
     "secret": true,
     "hint": "Calendly \u2192 Integrations \u2192 API & Webhooks \u2192 Personal access tokens. Booking needs a paid Calendly plan.",
     "default": "",
     "optional": false
    },
    {
     "key": "event_type",
     "label": "Event type link",
     "secret": false,
     "hint": "The event's API address, like https://api.calendly.com/event_types/XXXX (see Calendly's event types API).",
     "default": "",
     "optional": false
    },
    {
     "key": "timezone",
     "label": "Time zone",
     "secret": false,
     "hint": "",
     "default": "Asia/Kolkata",
     "optional": true
    }
   ],
   "actions": [
    {
     "name": "Check free appointment times",
     "key": "slots",
     "description": "Check which appointment times are free on a given day.",
     "params": [
      {
       "name": "date",
       "type": "string",
       "description": "The day to check, as YYYY-MM-DD",
       "required": true
      }
     ]
    },
    {
     "name": "Book an appointment",
     "key": "book",
     "description": "Book an appointment once the caller agreed a time. Calendly needs the caller's email.",
     "params": [
      {
       "name": "start",
       "type": "string",
       "description": "The agreed time, as YYYY-MM-DD HH:MM",
       "required": true
      },
      {
       "name": "name",
       "type": "string",
       "description": "The caller's name",
       "required": true
      },
      {
       "name": "email",
       "type": "string",
       "description": "The caller's email address",
       "required": true
      }
     ]
    }
   ],
   "pushes": false
  },
